    "build-day-detail": "npx esbuild src/js/dayDetailRenderer.js --bundle --outfile=src/js/bundles/dayDetailBundle.js --platform=browser",
    "build-client-dashboardlist": "npx esbuild src/clientDashboardRenderer.js --bundle --outfile=src/clientDashboardBundle.js --platform=browser"
