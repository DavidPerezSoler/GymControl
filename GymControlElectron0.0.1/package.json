  "name": "gymcontrol-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-login": "npx esbuild src/js/auth.js --bundle --outfile=src/js/bundles/authBundle.js --platform=browser",
    "build-clientManager": "npx esbuild src/js/clientManager.js --bundle --outfile=src/js/bundles/ClientManagerBundle.js --platform=browser",
    "build-registerTrainer": "npx esbuild src/js/registerTrainer.js --bundle --outfile=src/js/bundles/registerTrainerBundle.js --platform=browser",
